# Copy to .env.local for development, .env for production
# Never commit either file to version control

# ── Required ────────────────────────────────────────────
SECRET_KEY=
DATABASE_URL=

# ── Hosts ───────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_CORS=

# ── Email (production) ──────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Storage ─────────────────────────────────────────────
# Options: local (default), s3, gcs
STORAGE_BACKEND=local

# S3
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud Storage
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_CRED_PATH=

# ── Analytics & integrations ────────────────────────────
GOOGLE_ANALYTICS=

# ── reCAPTCHA (contact form) ────────────────────────────
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
